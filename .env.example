# Variables d'environnement — copier en `.env.local` pour le développement.
#
# Phase 1 (disponibilité via RDAP/DNS) ne nécessite AUCUNE clé.
# Les variables ci-dessous préparent les phases suivantes (prix, SEO, cache).

# --- Sélection des providers (pattern adaptateur) ---
# availability: rdap (défaut)
# AVAILABILITY_PROVIDER=rdap

# pricing: porkbun (Phase 2)
# PRICING_PROVIDER=porkbun

# seo: trends (Phase 3, gratuit) | dataforseo (payant)
# SEO_PROVIDER=trends

# --- Clés API (phases ultérieures) ---
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# --- Cache / rate-limit (Phase 5, optionnel) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
